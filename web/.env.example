# URL of the DammyRex API (no trailing slash)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Public URL of this website (no trailing slash), used for WhatsApp links, Open Graph and sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Business WhatsApp number, international format, digits only, no "+" (e.g. 2348012345678)
WHATSAPP_NUMBER="2348000000000"

# The following are NOT used by the website (API only). Listed here so both apps share one reference.
# DATABASE_URL, JWT_SECRET, CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET

# ---------- Google AdSense (optional) ----------
# Leave empty until Google approves the site. Even when set, AdSense only shows after the CEO
# switches it on in Admin → Ads, and only in spots that have no self-managed ad running.
NEXT_PUBLIC_ADSENSE_CLIENT=""        # e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_SLOT_HOME=""     # ad unit (slot) IDs from AdSense → Ads → By ad unit
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=""
NEXT_PUBLIC_ADSENSE_SLOT_ITEM=""
