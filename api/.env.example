# ---------- Database (Neon PostgreSQL) ----------
# Pooled connection string (host contains "-pooler"), used by the running app.
# Keep &connect_timeout=15 at the end: Neon's free tier sleeps and can take >5 s to wake.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Direct (non-pooled) connection string, used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ---------- Auth ----------
# Long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# ---------- First admin account (used by the seed script) ----------
ADMIN_NAME="Dammy"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# ---------- Cloudinary (image uploads) ----------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ---------- Business ----------
# International format, digits only, no "+" (e.g. 2348012345678)
WHATSAPP_NUMBER="2348000000000"

# ---------- Server ----------
PORT=4000
# Website origin(s) allowed by CORS, comma-separated
WEB_ORIGIN="http://localhost:3000"
# Public URL of this API (informational; the web app uses NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_API_URL="http://localhost:4000"
