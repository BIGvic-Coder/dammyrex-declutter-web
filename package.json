{
  "name": "dammyrex-declutter",
  "private": true,
  "description": "DammyRex Declutter: website (web) and backend (api)",
  "scripts": {
    "install:all": "npm install --prefix api && npm install --prefix web",
    "dev:api": "npm run start:dev --prefix api",
    "dev:web": "npm run dev --prefix web",
    "build:api": "npm run build --prefix api",
    "build:web": "npm run build --prefix web"
  }
}
